# Variáveis do backend. Para rodar fora do Docker, exporte-as no terminal
# (ou configure no run configuration da sua IDE). Nada é lido de arquivo automaticamente.

SPRING_PROFILES_ACTIVE=dev

# Bootstrap inicial de administrador (opt-in; desativado por padrão).
# Defina estas variáveis diretamente no ambiente do processo para habilitá-lo.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Banco local (docker compose up postgres) ou Supabase em produção
DATABASE_URL=jdbc:postgresql://localhost:5433/atlas
DATABASE_USERNAME=atlas
DATABASE_PASSWORD=REPLACE_WITH_YOUR_SECRET
# Supabase (Session Pooler):
# DATABASE_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project-ref>
DB_POOL_SIZE=5

# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_YOUR_SECRET
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed de demonstração não é executado por padrão.
# FLYWAY_LOCATIONS=classpath:db/migration

# Porta (a Render define PORT automaticamente)
# PORT=8080
