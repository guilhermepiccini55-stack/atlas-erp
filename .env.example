# ============================================================
# Atlas ERP - variáveis para o Docker Compose (copie para .env)
#   cp .env.example .env
# ============================================================

# --- PostgreSQL local (container) ---
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_SECRET

# --- Backend ---
# dev = liga o seed de demonstração. prod = sem seed (a menos que FLYWAY_LOCATIONS inclua o seed)
SPRING_PROFILES_ACTIVE=dev
# Mínimo 32 caracteres. Em produção gere com: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_YOUR_SECRET
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
# Origens permitidas no CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Portas expostas no host ---
API_PORT=8080
FRONTEND_PORT=5173

# --- Frontend (usado no build do container web) ---
VITE_API_URL=http://localhost:8080
